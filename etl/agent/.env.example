# Copy this file to ".env" in this same folder (or to the project root) and
# fill in your key. sap_migration_agent.py loads it automatically via
# python-dotenv -- nothing else in this project reads a .env file.
#
# Alternative: skip this file entirely and run `ant auth login` instead --
# the SDK will pick up that credential profile automatically with no .env
# and no ANTHROPIC_API_KEY needed.

ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides -- the defaults are the Anthropic endpoint and
# claude-opus-5. Any Anthropic-compatible endpoint works; for example
# Zhipu's GLM (get a key at https://open.bigmodel.cn):
#
#   ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
#   ANTHROPIC_MODEL=glm-4.5
#
# ANTHROPIC_BASE_URL=
# ANTHROPIC_MODEL=
